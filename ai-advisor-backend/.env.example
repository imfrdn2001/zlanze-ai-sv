APP_ENV=development
LOG_LEVEL=INFO
# Rotating JSON Lines log for conversation analysis.
LOG_FILE=logs/advisor.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Set false if user messages/responses must not be stored.
LOG_CHAT_CONTENT=true

# Use the privacy-filtered candidate JSON for talent search and counts.
TALENT_DATA_SOURCE=json
CANDIDATE_PROFILES_FILE=candidate_profiles-01 3.json

# Gemini is used only for intent/slot extraction. Keep the key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# The Docker Compose defaults connect to the separately deployed local database.
DATABASE_URL=mssql+pymssql://zlanze_ai_reader:ChangeThisReaderPassword_2026!@zlanze-sqlserver:1433/ZLANZE_PROD
REDIS_URL=redis://redis:6379/0
CONTEXT_TTL_SECONDS=1800

MAX_DEVELOPERS=5
MARKETPLACE_CURRENCY=USD
SQL_QUERY_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
